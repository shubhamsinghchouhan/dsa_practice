class KadanesAlgo:
  def algo(self, nums):
    # current_max = max(arr)
    local_max = nums[0]
    global_max = nums[0]

    for i in range(1,len(nums)):
      local_max = max(nums[i], local_max + nums[i])
      if local_max > global_max:
        global_max = local_max
    return global_max

nums = [-2,1,-3,4,-1,2,1,-5]
ka = KadanesAlgo()
print(ka.algo(nums))