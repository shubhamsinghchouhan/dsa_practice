# Linked list
class Node:
  def __init__(self, value):
    self.value = value
    self.next = None

class LinkedList:
  def __init__(self):
    self.head = None
    self.tail = None
    self.length = 0

  def __str__(self):
    """Helper method to visualize the linked list"""
    temp = self.head
    result = []
    while temp is not None:
      result.append(str(temp.value))
      temp = temp.next
    result.append("None")
    return " -> ".join(result)

  def append(self, value):
    new_node = Node(value)
    if self.head is None:
      self.head = new_node
      self.tail = new_node
    else:
      self.tail.next = new_node
      self.tail = new_node
    self.length += 1

  def prepend(self, value):
    new_node = Node(value)
    if self.head is None:
      self.head = new_node
      self.tail = new_node
    else:
      new_node.next = self.head
      self.head = new_node
    self.length += 1

  def get_node(self, index):
    if index < 0 or index >= self.length:
      return None
    current_node = self.head
    for _ in range(index):
      current_node = current_node.next
    return current_node

# Create a new linked list
my_linked_list = LinkedList()

# Append nodes
my_linked_list.append(10)
my_linked_list.append(20)
my_linked_list.append(30)
print(f"List after appending: {my_linked_list}")
# Output: List after appending: 10 -> 20 -> 30 -> None

# Prepend a node
my_linked_list.prepend(5)
print(f"List after prepending: {my_linked_list}")
# Output: List after prepending: 5 -> 10 -> 20 -> 30 -> None

# Get a node value at index 2
node = my_linked_list.get_node(2)
print(f"Node value at index 2: {node.value}")
print(f"my_linked_list: #{my_linked_list}")
# Output: Node value at index 2: 20
